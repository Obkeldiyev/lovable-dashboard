# ── Production environment ────────────────────────────────────────────────────
# When served through Nginx on port 8091, all API calls go through the same
# origin so we use relative paths (empty string = same origin).
# Nginx rewrites:
#   /api/*   → core backend  (port 9300)
#   /lapi/*  → logistics     (port 9100)
#   /live/*  → logistics SSE (port 9100)

VITE_API_BASE_URL=
VITE_LOGISTICS_BASE_URL=
VITE_POS_BASE_URL=

# Add your Yandex Maps API key here (see YANDEX_MAPS_GUIDE.md)
VITE_YANDEX_MAPS_KEY=1bdda971-83f6-43b6-a162-7fe7628d6d3c
